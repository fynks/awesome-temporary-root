{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module Compatibility Record",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "version": { "type": ["string", "null"] },
    "sourceUrl": { "type": ["string", "null"] },
    "documentationUrl": { "type": ["string", "null"] },
    "supportedRootMethods": { "type": "array", "items": { "type": "string" } },
    "androidVersions": { "type": "array", "items": { "type": "string" } },
    "supportedDevices": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["tested", "reproduced", "experimental", "candidate", "known_issue", "unknown"] },
    "testedAt": { "type": ["string", "null"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "name", "status"]
}