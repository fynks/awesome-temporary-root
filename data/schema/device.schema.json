{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device Compatibility Record",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "manufacturer": { "type": "string" },
    "deviceName": { "type": "string" },
    "modelNumbers": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "codenames": { "type": "array", "items": { "type": "string" } },
    "androidVersions": { "type": "array", "items": { "type": "string" } },
    "compatibilityRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "firmware": { "type": "string" },
          "kernel": { "type": "string" },
          "androidVersion": { "type": ["string", "null"] },
          "region": { "type": ["string", "null"] },
          "rootMethod": { "type": ["string", "null"] },
          "status": { "enum": ["tested", "reproduced", "experimental", "candidate", "known_issue", "unknown"] },
          "testedAt": { "type": ["string", "null"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "firmware", "kernel", "status"]
      }
    }
  },
  "required": ["id", "manufacturer", "deviceName", "compatibilityRecords"]
}