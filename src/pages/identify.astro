---
import BaseLayout from "../layouts/BaseLayout.astro";
import { devices, totalDevices, totalTested } from "../data/index";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { CardGrid } from "@/components/ui/card-grid";

const statusVariant: Record<string, string> = {
  Tested: "success",
  Experimental: "warning",
  "Upstream profile": "info",
  "Community reported": "info",
  "Unverified candidate": "caution",
  "Deprecated/unavailable": "danger",
};

const SVG_CLIPBOARD = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2v24h-6V4z"/><path d="M12 14h4"/></svg>';
const SVG_SEARCH = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
const SVG_SHIELD = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="8 10 12 14 16 10"/></svg>';
const SVG_LIST = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><path d="M6 6h.01"/><path d="M6 12h.01"/><path d="M6 18h.01"/></svg>';
const SVG_MOBILE = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="2" ry="2"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
const SVG_ARROW = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="13" y1="11" x2="21" y2="3"/><polyline points="18 3 21 3 21 6"/></svg>';
---

<BaseLayout
  title="Identify My Device — Check Temporary-Root Support"
  description="Identify whether your Android device has a confirmed temporary-root target. Record your model, build, and uname -r, then compare against the supported-device list."
>
  <div class="mb-6 bg-card border border-border rounded-lg p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight mb-2">Identify My Device</h1>
        <p class="text-muted-foreground">
          Find out whether your exact device has a hardware-confirmed temporary-root target. Record the identifiers below, then compare against the {totalDevices()} listed targets ({totalTested()} tested). If your exact build is not listed, <strong>do not try the closest one</strong>.
        </p>
      </div>
    </div>
  </div>

  <section class="mb-8">
    <h2 class="text-xl font-semibold mb-3 flex items-center gap-2">
      <span set:html={SVG_CLIPBOARD} class="inline-block w-5 h-5" /> Step 1 — Record your exact identifiers
    </h2>
    <p class="text-sm text-muted-foreground mb-4">
      Run these on your device (via ADB or Termux) and save the output where you can read it after a reboot:
    </p>
    <pre class="bg-muted p-3 rounded-lg text-sm font-mono overflow-x-auto"><code>adb shell getprop ro.product.model
adb shell getprop ro.product.device
adb shell getprop ro.build.display.id
adb shell getprop ro.build.version.release
adb shell uname -r</code></pre>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4">
      <div class="bg-muted/50 p-3 rounded-lg">
        <p class="text-xs font-semibold text-muted-foreground mb-1">Model</p>
        <p class="text-sm font-mono text-foreground" id="out-model">—</p>
      </div>
      <div class="bg-muted/50 p-3 rounded-lg">
        <p class="text-xs font-semibold text-muted-foreground mb-1">Build</p>
        <p class="text-sm font-mono text-foreground" id="out-build">—</p>
      </div>
      <div class="bg-muted/50 p-3 rounded-lg">
        <p class="text-xs font-semibold text-muted-foreground mb-1">Android</p>
        <p class="text-sm font-mono text-foreground" id="out-android">—</p>
      </div>
      <div class="bg-muted/50 p-3 rounded-lg">
        <p class="text-xs font-semibold text-muted-foreground mb-1">Kernel (uname -r)</p>
        <p class="text-sm font-mono text-foreground" id="out-kernel">—</p>
      </div>
    </div>
    <p class="text-xs text-muted-foreground mt-3">
      Without a computer: Settings › About phone gives the model and build; <code class="font-mono">uname -r</code> in Termux gives the kernel.
    </p>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-semibold mb-3 flex items-center gap-2">
      <span set:html={SVG_SEARCH} class="inline-block w-5 h-5" /> Step 2 — Match exact build upstream
    </h2>
    <p class="text-sm text-muted-foreground mb-4">
      Open the <a href="/explore" class="text-primary hover:underline">Device Explorer</a> and search for your market name or model. Confirm all three match exactly:
    </p>
    <ul class="list-disc list-inside text-sm text-muted-foreground space-y-2 mb-4">
      <li><strong>Model</strong> — e.g. <code class="font-mono">SM-S928U1</code>, <code class="font-mono">PD2520</code>, <code class="font-mono">IN2060</code></li>
      <li><strong>Firmware build</strong> — e.g. <code class="font-mono">S928USQS6DZF2</code> (not just the Android version)</li>
      <li><strong>Full kernel release</strong> — the complete <code class="font-mono">uname -r</code> output, not just "6.1"</li>
    </ul>
    <div class="bg-warning/10 border border-warning/20 rounded-lg p-4 mb-4">
      <p class="text-sm font-semibold text-warning-foreground mb-1">If your build is missing</p>
      <p class="text-sm text-warning-foreground/90">
        Stop. A partial match (same model, different build/kernel) is not enough — offsets come from a specific kernel build. Check the loader's own live table; the upstream table wins over this site.
      </p>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-semibold mb-3 flex items-center gap-2">
      <span set:html={SVG_SHIELD} class="inline-block w-5 h-5" /> Step 3 — Run only on authorized hardware
    </h2>
    <ul class="list-disc list-inside text-sm text-muted-foreground space-y-2 mb-4">
      <li>Use only a device you own or have explicit permission to modify.</li>
      <li>Back up data you cannot lose before running any loader.</li>
      <li>Install the manager the loader names; do not use install/flash/patch-boot-image actions on a locked phone.</li>
      <li>Shizuku is not root — it is an ADB-privileged transport.</li>
      <li>Root is temporary: a full reboot clears it.</li>
    </ul>
    <a href="/guide#quick-start" class="inline-flex items-center gap-2 text-sm text-primary hover:underline no-underline">
      Open Quick start <span set:html={SVG_ARROW} class="inline-block w-3 h-3 ml-1" />
    </a>
  </section>

  <section>
    <h2 class="text-xl font-semibold mb-3 flex items-center gap-2">
      <span set:html={SVG_LIST} class="inline-block w-5 h-5" /> Matching targets
    </h2>
    <p class="text-sm text-muted-foreground mb-4">Search or browse the full list. A green <kbd>Tested</kbd> badge means a hardware-confirmed run on that exact build.</p>
    <CardGrid id="identify-grid">
      {devices.map((d) => (
        <Card data-brand={d.brand} data-status={d.status}>
          <span set:html={SVG_MOBILE} class="inline-block w-6 h-6 mb-2.5 text-brand" />
          <h3 data-slot="card-title" class="m-0 text-base font-semibold leading-snug text-foreground">{d.marketName}</h3>
          <div data-slot="card-content" class="text-sm leading-relaxed text-muted-foreground space-y-2">
            <div class="flex flex-wrap gap-1.5">
              <Badge text={d.status} variant={statusVariant[d.status] as any} size="small" />
              <Badge text={d.method} variant="outline" size="small" />
            </div>
            <div class="font-mono text-xs text-foreground/70">{d.kernelRelease}</div>
            <div class="font-mono text-xs text-muted-foreground">{d.loader}</div>
            <div class="text-xs text-muted-foreground">{d.models.slice(0, 3).join(", ")}{d.models.length > 3 ? " +" + (d.models.length - 3) : ""}</div>
          </div>
        </Card>
      ))}
    </CardGrid>
  </section>
</BaseLayout>
