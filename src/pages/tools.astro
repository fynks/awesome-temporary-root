---
import BaseLayout from "../layouts/BaseLayout.astro";
import { tools, managers, totalTools, totalManagers } from "../data/index";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { CardGrid } from "@/components/ui/card-grid";

const licenseVariant: Record<string, string> = {
  "Apache-2.0": "success",
  "GPL-2.0-only": "caution",
  "GPL-2.0": "caution",
  "GPL-3.0": "caution",
  "AGPL-3.0": "caution",
  MIT: "info",
  "None (no LICENSE file)": "danger",
  NOASSERTION: "outline",
};

const methodVariant: Record<string, string> = {
  DirtyFrag: "success",
  GhostLock: "info",
  Adreno: "warning",
  Other: "outline",
  Mixed: "default",
};

const SVG_PACKAGE = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.34" x2="8.66" y2="17.24"/><path d="M21.17 11.17a5 5 0 0 0-.79-4.24L16 3m0 0l-4 4m4-4L3.83 15.17a5 5 0 0 0-.79 4.24l5.28 5.28a5 5 0 0 0 4.24-.79L21 17m0 0l4-4m-4 4L11 7"/></svg>';
const SVG_USER_COG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="7"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/><path d="M12 12h3"/></svg>';
const SVG_ARROW = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="13" y1="11" x2="21" y2="3"/><polyline points="18 3 21 3 21 6"/></svg>';
---

<BaseLayout
  title="Tools & Managers Directory"
  description="Exploit loaders, KernelSU-compatible managers, transports, and kernel-module sets for Android temporary root. Download from each project's own release page."
>
  <div class="mb-6 bg-card border border-border rounded-lg p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight mb-2">Tools &amp; Managers Directory</h1>
        <p class="text-muted-foreground">
          {totalTools()} loaders and ports, {totalManagers()} KernelSU-compatible managers. A temporary root setup needs a loader plus a manager that ships <code class="font-mono">libksud.so</code>. Download only from each project's own release page — no APKs or binaries are hosted here.
        </p>
      </div>
      <div class="flex gap-2 text-xs font-mono text-muted-foreground/80">
        <span set:html={SVG_PACKAGE} class="inline-block w-3.5 h-3.5 inline mr-1" /> {totalTools()} tools
        <span set:html={SVG_USER_COG} class="inline-block w-3.5 h-3.5 inline mr-1" /> {totalManagers()} managers
      </div>
    </div>
  </div>

  <aside class="mb-6 border border-border rounded-lg bg-muted/50 p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Safety before you run anything</h2>
    <ul class="list-disc list-inside text-sm text-muted-foreground space-y-1 space-y-reverse">
      <li>Use only devices you own or have explicit permission to modify.</li>
      <li>Back up data you cannot lose — a wrong profile can panic or bootloop the device.</li>
      <li>Match exact model + build + <code class="font-mono">uname -r</code> upstream before running a loader.</li>
      <li>Shizuku is <strong>not root</strong> — it is an ADB-privileged transport some loaders use.</li>
      <li>Do not use a manager's install, flash, or patch-boot-image actions on a locked phone.</li>
      <li>Root is temporary: a full reboot clears it.</li>
    </ul>
  </aside>

  <h2 class="text-xl font-semibold mb-4">Exploit loaders and device-specific ports</h2>
  <CardGrid>
    {tools.map((t) => (
      <Card title={t.name} href={t.repo} class="group">
        <div class="mb-3 flex flex-wrap gap-1.5">
          <Badge text={t.method} variant={methodVariant[t.method] as any} size="small" />
          {t.cve !== "Other" && <Badge text={t.cve} variant="default" size="small" />}
          {t.archived && <Badge text="Archived" variant="danger" size="small" />}
        </div>
        <p class="text-sm text-muted-foreground mb-3 line-clamp-2">{t.coverage}. {t.transport} transport.</p>
        <div class="flex flex-wrap gap-2 text-xs">
          <Badge text={t.license} variant={(licenseVariant[t.license] ?? "default") as any} size="small" />
          <Badge text={t.stars + "★"} variant="outline" size="small" />
          <Badge text={t.pushed} variant="default" size="small" />
        </div>
        <p class="mt-3 text-xs text-muted-foreground line-clamp-2">{t.notes}</p>
        <div class="mt-4 pt-3 border-t border-border flex items-center justify-between">
          <a href={t.releaseUrl || t.repo} class="text-sm text-primary hover:underline no-underline">
            {t.releaseUrl ? "Release page" : "Source"} <span set:html={SVG_ARROW} class="inline-block w-3 h-3 ml-1" />
          </a>
          <span class="text-xs text-muted-foreground font-mono">{t.sourceProvenance.split(",")[0]}</span>
        </div>
      </Card>
    ))}
  </CardGrid>

  <h2 class="text-xl font-semibold mt-10 mb-4">KernelSU-compatible root managers</h2>
  <p class="text-sm text-muted-foreground mb-4">The manager must ship <code class="font-mono">libksud.so</code>; a loader uses it to stage <code class="font-mono">ksud</code>. Use the manager the loader names.</p>
  <CardGrid>
    {managers.map((m) => (
      <Card title={m.name} href={m.repo} class="group">
        <p class="text-sm text-muted-foreground mb-3">{m.description} — {m.useFor}.</p>
        <div class="flex flex-wrap gap-2 text-xs mb-3">
          <Badge text={m.license} variant={(licenseVariant[m.license] ?? "default") as any} size="small" />
          <Badge text={m.providesKsud ? "ships libksud.so" : "no libksud.so"} variant={m.providesKsud ? "success" : "danger"} size="small" />
          <Badge text={m.stars + "★"} variant="outline" size="small" />
        </div>
        <p class="text-xs text-muted-foreground line-clamp-2">{m.notes}</p>
      </Card>
    ))}
  </CardGrid>

  <p class="mt-8 text-xs text-muted-foreground text-center">
    Do not treat a multi-device repack as a trusted upstream. A manager alone does not provide temporary root.
  </p>
</BaseLayout>
