---
import BaseLayout from "../layouts/BaseLayout.astro";
import { devices, countByStatus, countByBrand, STATUS_LABELS, totalDevices, totalTested } from "../data/index";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { CardGrid } from "@/components/ui/card-grid";

const statusCounts = countByStatus();
const brandCounts = countByBrand();

const statusVariant: Record<string, string> = {
  Tested: "success",
  Experimental: "warning",
  "Upstream profile": "info",
  "Community reported": "info",
  "Unverified candidate": "caution",
  "Deprecated/unavailable": "danger",
};

const ALL_STATUSES = ["Tested", "Experimental", "Upstream profile", "Community reported", "Unverified candidate", "Deprecated/unavailable"] as const;

const SVG_CPU = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="6"/><rect x="9" y="15" width="6" height="6"/><rect x="3" y="9" width="6" height="6"/><rect x="15" y="9" width="6" height="6"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="3" y1="12" x2="21" y2="12"/></svg>';
const SVG_SEARCH = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
const SVG_SHIELD = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="8 10 12 14 16 10"/></svg>';
const SVG_REFRESH = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 17a9 9 0 0 0-1-9V1"/><polyline points="15 6 21 6 21 12"/></svg>';
const SVG_MOBILE = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="2" ry="2"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
const SVG_BUILDING = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"/><path d="M10 13h4v8h-4z"/></svg>';
---

<BaseLayout
  title="Device Explorer — Supported Temporary-Root Targets"
  description="Search and filter every hardware-confirmed temporary-root target by brand, status, kernel, and loader. Match your exact model, build, and uname -r before running a loader."
>
  <div class="mb-6 bg-brand/10 border border-brand/20 rounded-lg p-6 md:p-8 text-brand-foreground">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight mb-2">Device Explorer</h1>
        <p class="text-brand-foreground/90">
          Search {totalDevices()} listed targets ({totalTested()} hardware-tested). Match your exact model, firmware build, and <code class="font-mono">uname -r</code> before running any loader. A partial match is not enough.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-mono text-brand-foreground/80">
        <span set:html={SVG_CPU} class="inline-block w-4 h-4 mr-1" /> 4.9–6.12
        <span set:html={SVG_SHIELD} class="inline-block w-4 h-4 mr-1" /> Locked bootloader
        <span set:html={SVG_REFRESH} class="inline-block w-4 h-4 mr-1" /> Temporary root
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mb-6">
    {ALL_STATUSES.map((st) => {
      const n = statusCounts[st as keyof typeof statusCounts] ?? 0;
      return (
        <Badge
          text={STATUS_LABELS[st as keyof typeof STATUS_LABELS] + " (" + n + ")"}
          variant={(statusVariant[st] ?? "default") as any}
          size="small"
        />
      );
    })}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="relative">
      <span set:html={SVG_SEARCH} class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
      <input
        id="device-search"
        type="search"
        placeholder="Search model, brand, kernel, loader…"
        class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-input bg-input text-sm focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
      />
    </div>
    <div class="relative">
      <span set:html={SVG_BUILDING} class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
      <select
        id="brand-filter"
        class="w-full pl-9 pr-4 py-2.5 rounded-lg border border-input bg-input text-sm focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
      >
        <option value="">All brands</option>
        {Object.entries(brandCounts).map(([b, n]) => (
          <option value={b}>{b} ({n})</option>
        ))}
      </select>
    </div>
  </div>

  <p id="result-count" class="text-sm text-muted-foreground mb-4">
    Showing <span id="count">{devices.length}</span> of {devices.length} targets
  </p>

  <CardGrid id="device-grid">
    {devices.map((d) => (
      <Card
        data-brand={d.brand}
        data-status={d.status}
        data-kernel={d.kernelRelease}
        data-loader={d.loader}
      >
        <div class="flex flex-col gap-2">
          <span set:html={SVG_MOBILE} class="inline-block w-6 h-6 text-brand" />
          <h3 class="m-0 text-base font-semibold leading-snug text-foreground">{d.marketName}</h3>
          <div class="text-sm leading-relaxed text-muted-foreground space-y-2">
            <div class="flex flex-wrap gap-1.5">
              <Badge text={d.status} variant={(statusVariant[d.status] ?? "default") as any} size="small" />
              <Badge text={d.method} variant="outline" size="small" />
            </div>
            <div class="font-mono text-xs text-foreground/70">{d.kernelRelease}</div>
            <div class="font-mono text-xs text-foreground/70">{d.models.slice(0, 3).join(", ")}{d.models.length > 3 ? " +" + (d.models.length - 3) : ""}</div>
            <div class="text-xs text-muted-foreground">{d.brand} · {d.loader}</div>
          </div>
        </div>
      </Card>
    ))}
  </CardGrid>

  <p class="mt-6 text-xs text-muted-foreground text-center">
    Statuses: <kbd>Tested</kbd> = hardware-confirmed · <kbd>Upstream profile</kbd> = upstream lists a profile, no confirmed run · <kbd>Community reported</kbd> = project ships tables, no run documented here. Match exact model + build + <code>uname -r</code> upstream before running anything.
  </p>

  <script>
    (function () {
      const searchInput = document.getElementById("device-search") as HTMLInputElement;
      const brandSelect = document.getElementById("brand-filter") as HTMLSelectElement;
      const resultCount = document.getElementById("count") as HTMLElement;
      const cards = document.querySelectorAll("#device-grid > article");
      const grid = document.getElementById("device-grid") as HTMLElement;

      const STATUS_ORDER: Record<string, number> = { "Tested": 0, "Experimental": 1, "Upstream profile": 2, "Community reported": 3, "Unverified candidate": 4, "Deprecated/unavailable": 5 };

      function render() {
        if (!searchInput || !brandSelect || !resultCount || !grid) return;
        const q = searchInput.value.toLowerCase().trim();
        const brand = brandSelect.value;
        let shown = 0;
        const matched: HTMLElement[] = [];
        cards.forEach((card) => {
          const el = card as HTMLElement;
          const text = (el.getAttribute("data-brand") || "") + " " +
            (el.getAttribute("data-status") || "") + " " +
            (el.getAttribute("data-kernel") || "") + " " +
            (el.getAttribute("data-loader") || "") + " " +
            el.textContent.toLowerCase();
          const brandOk = !brand || el.getAttribute("data-brand") === brand;
          const textOk = !q || text.includes(q);
          const show = brandOk && textOk;
          el.style.display = show ? "" : "none";
          if (show) { shown++; matched.push(el); }
        });
        matched.sort((a, b) => {
          const sa = STATUS_ORDER[a.getAttribute("data-status") ?? ""] ?? 99;
          const sb = STATUS_ORDER[b.getAttribute("data-status") ?? ""] ?? 99;
          if (sa !== sb) return sa - sb;
          const na = (a.querySelector("h3") ?? a).textContent.trim();
          const nb = (b.querySelector("h3") ?? b).textContent.trim();
          return na.localeCompare(nb);
        });
        matched.forEach((c) => grid.appendChild(c));
        resultCount.textContent = String(shown);
      }
      searchInput.addEventListener("input", render);
      brandSelect.addEventListener("change", render);
      render();
    })();
  </script>
</BaseLayout>
