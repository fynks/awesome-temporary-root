---
/* The site's ghost mark, inline so it takes the text colour in light and dark.
   The drawing lives in logo.ts, which the social cards read too. */
import { logo } from "./logo";

interface Props { class?: string }
const { class: cls = "h-6 w-6" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${logo.width} ${logo.height}`} class={cls} aria-hidden="true">{logo.paths.map((d) => <path d={d} fill="currentColor" fill-rule={logo.fillRule} />)}</svg>
