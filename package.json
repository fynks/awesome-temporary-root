    "preview": "vitepress preview docs --host 0.0.0.0",
    "check": "node scripts/sync-readme.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vite-pwa/vitepress": "^2.0.3",
    "magicast": "^0.5.5",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.15.0",
    "vue": "^3.5.43"
  }
}
