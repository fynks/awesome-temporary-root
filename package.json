{
  "name": "temp-root-checker",
  "version": "1.0.0",
  "description": "Android temporary root compatibility reference tool",
  "type": "module",
  "scripts": {
    "data:generate": "node scripts/generate-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "readme:generate": "node scripts/generate-readme.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev-server.mjs",
    "preview": "node scripts/dev-server.mjs --built",
    "test": "node --test",
    "lint": "for f in scripts/*.mjs website/js/*.js tests/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "android",
    "temporary-root",
    "compatibility",
    "kernel",
    "firmware"
  ],
  "author": "fynks",
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}