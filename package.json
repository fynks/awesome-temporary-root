{
  "name": "awesome-temporary-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "sync:readme": "node scripts/sync-readme.mjs",
    "dev": "node scripts/sync-readme.mjs && vitepress dev docs --host 0.0.0.0",
