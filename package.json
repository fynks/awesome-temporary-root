{
  "name": "awesome-temporary-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "sync:readme": "bun scripts/sync-readme.mjs",
    "dev": "bun scripts/sync-readme.mjs && bunx vitepress dev docs --host 0.0.0.0",
    "build": "bun scripts/sync-readme.mjs && bunx vitepress build docs",
    "preview": "bunx vitepress preview docs --host 0.0.0.0",
    "check": "bun scripts/sync-readme.mjs && bun check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vite-pwa/vitepress": "^2.0.5",
    "magicast": "^0.5.5",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.15.0",
    "vue": "^3.5.46"
  }
}
